# 统一换行符，避免 Windows / macOS / Linux 混用导致整个文件被标记为改动
* text=auto

# Go
*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.proto   text eol=lf

# 前端
*.js      text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.md      text eol=lf

# Makefile / Dockerfile 必须 LF
Makefile  text eol=lf
Dockerfile text eol=lf
*.sh      text eol=lf

# Windows 脚本必须 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary

# 生成代码在 diff 时不显示（但仍然提交）
**/*.pb.go linguist-generated=true
